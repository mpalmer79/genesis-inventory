{
  "name": "genesis-inventory",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run check:scraper && npm run check:search",
    "check:scraper": "node --check scraper/config.js && node --check scraper/normalize.js && node --check scraper/validate.js && node --check scraper/scrape.js && node --check scraper/normalize.test.js && node --check scraper/validate.test.js",
    "check:search": "node --check lib/search.js && node --check lib/search.test.js",
    "test": "node --test scraper/normalize.test.js scraper/validate.test.js lib/search.test.js",
    "test:scraper": "node --test scraper/normalize.test.js scraper/validate.test.js",
    "test:search": "node --test lib/search.test.js",
    "scrape": "node scraper/scrape.js"
  },
  "dependencies": {
    "next": "16.3.4",
    "playwright": "^1.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
